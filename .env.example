# ==============================================================================
# CertiChain — Environment Variables Template
# Copy this file to .env for local deployment or configure in Vercel project settings
# NEVER commit your actual .env file or private keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HARDHAT & SMART CONTRACT DEPLOYMENT (Used by scripts/deploy.cjs)
# ------------------------------------------------------------------------------

# Ethereum Sepolia RPC URL (from Alchemy, Infura, QuickNode, or public endpoint)
# Free Alchemy RPC: https://www.alchemy.com/
# Free Infura RPC:  https://www.infura.io/
# Public fallback:  https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Deployer wallet private key (64 hex characters without or with 0x prefix)
# Obtain from MetaMask: Account Details -> Show Private Key
# MUST have Sepolia testnet ETH (Get free faucet ETH: https://sepoliafaucet.com / https://faucets.chain.link)
# CAUTION: Use a dedicated development/testing wallet, NOT your personal mainnet wallet.
PRIVATE_KEY=your_sepolia_wallet_private_key_here

# Etherscan API Key for automated contract source code verification on Sepolia
# Free from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ------------------------------------------------------------------------------
# 2. FRONTEND PRODUCTION CONFIGURATION (Used by React / Vite / Vercel)
# Configure these in Vercel Dashboard -> Settings -> Environment Variables
# ------------------------------------------------------------------------------

# Deployed CertiChain Smart Contract Address
# Auto-populated in src/config/deployment.json after running 'npm run deploy:sepolia'
# Or override here directly in Vercel production:
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Target Blockchain Chain ID
# 11155111 = Ethereum Sepolia Testnet
# 31337    = Hardhat Localhost Node
VITE_CHAIN_ID=11155111

# Human-readable network name shown in UI
VITE_NETWORK_NAME="Ethereum Sepolia"

# Public RPC URL for frontend read-only queries (browsing certificates without wallet)
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
