{
  "name": "blockchain-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "compile": "hardhat compile",
    "test:contract": "hardhat test",
    "chain": "hardhat node",
    "deploy": "hardhat run scripts/deploy.cjs --network localhost",
    "deploy:local": "hardhat run scripts/deploy.cjs --network hardhat",
    "deploy:sepolia": "hardhat run scripts/deploy-sepolia.cjs --network sepolia",
    "verify:sepolia": "hardhat verify --network sepolia",
    "seed:demo": "hardhat run scripts/seed-demo.cjs --network localhost",
    "start": "concurrently \"npm run chain\" \"npm run deploy\" \"npm run dev\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.8",
    "hardhat": "^2.29.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  }
}
